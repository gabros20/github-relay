{
  "name": "github-relay-mcp",
  "version": "0.1.0",
  "description": "Research GitHub, not read GitHub — a zero-paid-API, LLM-free Bun/TypeScript CLI (ghrelay) + MCP shim + Claude Code skill that turns intent into a ranked, explainable, star-skeptical shortlist of repos.",
  "type": "module",
  "bin": {
    "ghrelay": "./dist/cli.js",
    "github-relay-mcp": "./dist/mcp-shim.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {},
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    ".claude/skills/github-relay/SKILL.md"
  ],
  "scripts": {
    "generate": "bun run scripts/generate-skill.ts",
    "dev": "bun run generate && bun run src/cli.ts",
    "build": "bun run generate && tsup",
    "typecheck": "bun run generate && tsc --noEmit",
    "lint": "bun run generate && biome check src/ tests/",
    "lint:fix": "bun run generate && biome check --write src/ tests/",
    "format": "biome format --write src/ tests/",
    "test": "bun run generate && bun test",
    "test:watch": "bun run generate && bun test --watch",
    "test:coverage": "bun run generate && bun test --coverage",
    "check": "bun run typecheck && bun run lint && bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/bun": "^1.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.3.0"
  },
  "keywords": [
    "github",
    "search",
    "mcp",
    "cli",
    "claude",
    "agent",
    "code-execution",
    "deep-research"
  ],
  "author": "Tamas Gabor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gabros20/github-relay"
  },
  "homepage": "https://github.com/gabros20/github-relay#readme",
  "bugs": {
    "url": "https://github.com/gabros20/github-relay/issues"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "esbuild"
  ]
}
